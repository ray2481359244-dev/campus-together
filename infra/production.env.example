# Copy to a private file on the chosen server. Keep it outside the release and Git.
NODE_ENV=production
APP_MODE=STANDARD
PORT=3001
HOST=127.0.0.1
TRUST_PROXY=loopback
SERVE_ORIGIN=https://REPLACE_WITH_YOUR_DOMAIN
DATABASE_URL=postgresql://campus_app:REPLACE_WITH_STRONG_DATABASE_PASSWORD@127.0.0.1:5432/campus_live
CSRF_SECRET=REPLACE_WITH_SEPARATE_RANDOM_SECRET
AI_MODE=RULES_ONLY
CHAT_ARCHIVE_SECONDS=2592000
# Keep an independent secure copy of the backup key; never upload it to GitHub.
BACKUP_KEY_FILE=/etc/campus/backup.key
BACKUP_DIR=/var/lib/campus/backups
