generator client {
  provider = "prisma-client"
  output   = "../apps/server/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Category {
  GAME
  STUDY
  COMPETITION
  OUTDOOR
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum ContentStatus {
  PUBLISHED
  HIDDEN
  DELETED
}

model School {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique @db.VarChar(80)
  city      String   @db.VarChar(40)
  isDemo    Boolean  @default(false)
  active    Boolean  @default(true)
  profiles  Profile[]
  posts     Post[]
  recruitments Recruitment[]
  createdAt DateTime @default(now()) @db.Timestamptz(3)
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique @db.VarChar(254)
  passwordHash String
  role         UserRole   @default(USER)
  status       UserStatus @default(ACTIVE)
  profile      Profile?
  sessions     Session[]
  posts        Post[]
  recruitments Recruitment[]
  captainTeams Team[] @relation("TeamCaptain")
  recruitmentCreateRequests RecruitmentCreateRequest[]
  memberships TeamMember[]
  applications Application[]
  applicationRequests ApplicationRequest[]
  applicationReviews ApplicationReview[] @relation("ApplicationReviewer")
  notifications Notification[]
  domainEvents DomainEvent[]
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @db.Timestamptz(3)
}

model Profile {
  userId    String   @id @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  schoolId  String   @db.Uuid
  school    School   @relation(fields: [schoolId], references: [id])
  nickname  String   @db.VarChar(20)
  bio       String   @default("") @db.VarChar(300)
  skills    String[] @default([])
  grade     String   @default("") @db.VarChar(20)
  interests Category[] @default([])
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique @db.Char(64)
  csrfHash  String   @db.Char(64)
  userId    String?  @db.Uuid
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model Topic {
  id             String   @id @default(uuid()) @db.Uuid
  category       Category
  name           String   @db.VarChar(40)
  normalizedName String   @db.VarChar(80)
  description    String   @default("") @db.VarChar(300)
  active         Boolean  @default(true)
  posts          Post[]
  recruitments Recruitment[]
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  @@unique([category, normalizedName])
}

model Post {
  id        String        @id @default(uuid()) @db.Uuid
  authorId  String        @db.Uuid
  author    User          @relation(fields: [authorId], references: [id])
  schoolId  String        @db.Uuid
  school    School        @relation(fields: [schoolId], references: [id])
  topicId   String        @db.Uuid
  topic     Topic         @relation(fields: [topicId], references: [id])
  title     String        @db.VarChar(60)
  body      String        @db.VarChar(5000)
  status    ContentStatus @default(PUBLISHED)
  revision  Int           @default(1)
  createdAt DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @db.Timestamptz(3)
  deletedAt DateTime?     @db.Timestamptz(3)
  createRequestKey String? @db.Uuid
  createRequestHash String? @db.Char(64)
  recruitments Recruitment[]

  @@unique([authorId, createRequestKey])
  @@index([schoolId, status, createdAt, id])
  @@index([topicId, status, createdAt, id])
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
}

enum TeamStatus {
  OPEN
  FULL
  IN_PROGRESS
  COMPLETED
  CANCELLED
  EXPIRED
}

enum MemberRole {
  CAPTAIN
  MEMBER
}

enum MemberStatus {
  ACTIVE
  LEFT
  REMOVED
}

model Recruitment {
  id String @id @default(uuid()) @db.Uuid
  authorId String @db.Uuid
  author User @relation(fields: [authorId], references: [id], onDelete: Restrict)
  schoolId String @db.Uuid
  school School @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  topicId String? @db.Uuid
  topic Topic? @relation(fields: [topicId], references: [id], onDelete: Restrict)
  sourcePostId String? @db.Uuid
  sourcePost Post? @relation(fields: [sourcePostId], references: [id], onDelete: SetNull)
  category Category @default(COMPETITION)
  title String @default("") @db.VarChar(60)
  description String @default("") @db.VarChar(3000)
  payload Json
  publicationStatus PublicationStatus @default(DRAFT)
  revision Int @default(1)
  createRequestKey String @db.Uuid
  createRequestHash String @db.Char(64)
  startAt DateTime? @db.Timestamptz(3)
  endAt DateTime? @db.Timestamptz(3)
  joinDeadline DateTime? @db.Timestamptz(3)
  capacity Int
  allowCrossSchool Boolean @default(false)
  publishedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  team Team?
  createRequest RecruitmentCreateRequest?

  @@unique([authorId, createRequestKey])
  @@index([schoolId, publicationStatus, publishedAt, id])
  @@index([topicId, publicationStatus])
}

model RecruitmentCreateRequest {
  authorId String @db.Uuid
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  requestKey String @db.Uuid
  requestHash String @db.Char(64)
  recruitmentId String? @unique @db.Uuid
  recruitment Recruitment? @relation(fields: [recruitmentId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@id([authorId, requestKey])
}

model Team {
  id String @id @default(uuid()) @db.Uuid
  recruitmentId String @unique @db.Uuid
  recruitment Recruitment @relation(fields: [recruitmentId], references: [id], onDelete: Cascade)
  captainUserId String @db.Uuid
  captain User @relation("TeamCaptain", fields: [captainUserId], references: [id], onDelete: Restrict)
  status TeamStatus @default(OPEN)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  slots TeamSlot[]
  members TeamMember[]
  chatSpace ChatSpace?
  events DomainEvent[]
  applications Application[]
}

model TeamSlot {
  id String @id @default(uuid()) @db.Uuid
  teamId String @db.Uuid
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  name String @db.VarChar(30)
  capacity Int
  requiredSkills String[] @default([])
  position Int
  members TeamMember[]
  applications Application[]

  @@unique([id, teamId])
  @@unique([teamId, position])
}

model TeamMember {
  id String @id @default(uuid()) @db.Uuid
  teamId String @db.Uuid
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  slotId String @db.Uuid
  slot TeamSlot @relation(fields: [slotId, teamId], references: [id, teamId], onDelete: Cascade)
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  role MemberRole
  status MemberStatus @default(ACTIVE)
  joinedAt DateTime @default(now()) @db.Timestamptz(3)
  leftAt DateTime? @db.Timestamptz(3)

  @@unique([teamId, userId])
}

model ChatSpace {
  id String @id @default(uuid()) @db.Uuid
  teamId String @unique @db.Uuid
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
}

model DomainEvent {
  id String @id @default(uuid()) @db.Uuid
  teamId String @db.Uuid
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  actorId String? @db.Uuid
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  kind String @db.VarChar(60)
  payload Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
  EXPIRED
}

model Application {
  id String @id @default(uuid()) @db.Uuid
  teamId String @db.Uuid
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  applicantId String @db.Uuid
  applicant User @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  slotId String @db.Uuid
  slot TeamSlot @relation(fields: [slotId, teamId], references: [id, teamId], onDelete: NoAction)
  status ApplicationStatus @default(PENDING)
  message String @db.VarChar(1000)
  timeConfirmed Boolean
  eligibilitySnapshot Json
  submissionHash String @db.Char(64)
  submission Int @default(1)
  revision Int @default(1)
  submittedAt DateTime @default(now()) @db.Timestamptz(3)
  resolvedAt DateTime? @db.Timestamptz(3)
  requests ApplicationRequest[]
  reviews ApplicationReview[]

  @@unique([teamId, applicantId])
  @@unique([id, applicantId])
  @@index([applicantId, status, submittedAt])
  @@index([teamId, status])
}

model ApplicationRequest {
  applicantId String @db.Uuid
  applicant User @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  requestKey String @db.Uuid
  requestHash String @db.Char(64)
  applicationId String @db.Uuid
  application Application @relation(fields: [applicationId, applicantId], references: [id, applicantId], onDelete: Cascade)
  submission Int
  snapshot Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@id([applicantId, requestKey])
  @@index([applicationId])
}

enum ReviewDecision {
  APPROVE
  REJECT
}

model ApplicationReview {
  id String @id @default(uuid()) @db.Uuid
  applicationId String @db.Uuid
  applicantId String @db.Uuid
  application Application @relation(fields: [applicationId, applicantId], references: [id, applicantId], onDelete: Cascade)
  reviewerId String @db.Uuid
  reviewer User @relation("ApplicationReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  submission Int
  expectedRevision Int
  decision ReviewDecision
  reason String @db.VarChar(500)
  slotName String @db.VarChar(30)
  recruitmentTitle String @db.VarChar(60)
  eligibilitySnapshot Json?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  notification Notification?

  @@unique([applicationId, submission])
  @@unique([applicationId, expectedRevision])
  @@unique([id, applicantId])
}

model Notification {
  id String @id @default(uuid()) @db.Uuid
  recipientId String @db.Uuid
  recipient User @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  reviewId String @unique @db.Uuid
  review ApplicationReview @relation(fields: [reviewId, recipientId], references: [id, applicantId], onDelete: Cascade)
  readAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([recipientId, createdAt, id])
  @@index([recipientId, readAt])
  @@unique([reviewId, recipientId])
}
