# Run pnpm setup to create .env with a random local database password.
# External PostgreSQL is supported: set DATABASE_URL and skip db:local.
DATABASE_URL=postgresql://campus:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:5432/campus
TEST_DATABASE_URL=postgresql://campus:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:5432/campus_test
LOCAL_PG_PORT=5432
PORT=3001
WEB_ORIGIN=http://127.0.0.1:5173
APP_MODE=DEMO
NODE_ENV=development
# Optional future LIVE AI integration; do not use VITE_ prefixes for secrets.
AI_MODE=RULES_ONLY
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
