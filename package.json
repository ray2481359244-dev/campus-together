{
  "name": "campus-together",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.1",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "local": "node scripts/local.mjs",
    "demo": "node scripts/demo.mjs",
    "demo:status": "node scripts/demo.mjs --status",
    "demo:scene": "node scripts/demo.mjs --new-scene",
    "test:demo": "node --test tests/demo.test.mjs",
    "test:demo-flow": "node scripts/check-demo.mjs",
    "doctor": "node scripts/doctor.mjs",
    "test:startup": "node --test tests/startup.test.mjs",
    "test:serve": "node --test tests/serve.test.mjs",
    "db:local": "tsx scripts/local-db.ts",
    "db:generate": "prisma generate --config prisma7.config.ts",
    "db:migrate": "prisma migrate deploy --config prisma7.config.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:check": "tsx scripts/db-check.ts",
    "dev": "node scripts/dev.mjs",
    "dev:web": "pnpm --filter @campus/web dev",
    "dev:server": "pnpm --filter @campus/server dev",
    "typecheck": "tsc --noEmit -p apps/server/tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json",
    "build": "pnpm --filter @campus/web build && node scripts/build.mjs",
    "start": "node scripts/serve.mjs",
    "db:stop": "tsx scripts/local-db.ts --stop",
    "test": "node scripts/prepare-tests.mjs && vitest run",
    "test:e2e": "playwright test",
    "test:persistence": "node scripts/check-persistence.mjs",
    "test:recruitment-recovery": "node scripts/check-recruitment-recovery.mjs",
    "test:application-recovery": "node scripts/check-application-recovery.mjs",
    "test:review-recovery": "node scripts/check-review-recovery.mjs",
    "test:team-recovery": "node scripts/check-team-recovery.mjs",
    "test:lifecycle-recovery": "node scripts/check-lifecycle-recovery.mjs",
    "test:expiry-recovery": "node scripts/check-expiry-recovery.mjs",
    "test:chat-recovery": "node scripts/check-chat-recovery.mjs",
    "test:archive-recovery": "node scripts/check-archive-recovery.mjs",
    "test:ai-protocol": "tsx scripts/check-ai-protocol.ts",
    "test:assistance-recovery": "node scripts/check-assistance-recovery.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "backup:key": "node scripts/backup.mjs init-key",
    "backup:create": "node scripts/backup.mjs create",
    "backup:restore": "node scripts/backup.mjs restore",
    "test:backup": "node scripts/check-backup-recovery.mjs",
    "test:release": "node --test tests/release.test.mjs",
    "release:prepare": "pnpm build && node scripts/release.mjs",
    "deploy:preflight": "node scripts/preflight.mjs",
    "bootstrap:school": "node scripts/bootstrap.mjs school",
    "bootstrap:admin": "node scripts/bootstrap.mjs admin",
    "release:verify": "node scripts/verify-release.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "dotenv": "18.0.8",
    "embedded-postgres": "18.4.0-beta.17",
    "prisma": "7.10.0",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  },
  "dependencies": {
    "pg": "8.23.1"
  }
}
